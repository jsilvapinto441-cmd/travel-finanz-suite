# Modelo de variáveis de ambiente do Rotas.
# Copie para ".env" e preencha com os dados do SEU projeto. Não use valores reais neste arquivo.

# --- Navegador (expostas ao cliente; apenas valores públicos) ---
VITE_SUPABASE_URL="https://<seu-projeto>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<sua-chave-publica>"
VITE_SUPABASE_PROJECT_ID="<id-do-projeto>"

# --- Servidor ---
SUPABASE_URL="https://<seu-projeto>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<sua-chave-publica>"
SUPABASE_PROJECT_ID="<id-do-projeto>"

# Chaves privadas: configure apenas no ambiente do servidor/hospedagem. Nunca publique.
SUPABASE_SERVICE_ROLE_KEY="<chave-service-role>"
LOVABLE_API_KEY="<chave-do-gateway-de-ia>"
